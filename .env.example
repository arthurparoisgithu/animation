# Copier ce fichier en .env et remplir les valeurs.
# .env est dans le .gitignore : il ne doit jamais etre commite.
#
# Sous Windows, demarrer.bat cree ce fichier tout seul et l'ouvre dans le
# Bloc-notes : il n'y a que la cle a coller.

# La cle d'API, a creer sur https://console.anthropic.com
# C'est la seule ligne obligatoire.
ANTHROPIC_API_KEY=sk-ant-...

# Postgres. Cette valeur sert a une installation locale classique.
# Avec Docker, docker-compose.yml la remplace automatiquement : dans le
# reseau des conteneurs la base ne s'appelle pas « localhost » mais « base ».
DATABASE_URL=postgresql+psycopg://animation:animation@localhost:5432/animation

# Obligatoire des que MODE_MODELE=api : sans lui, l'interface refuse de
# generer. C'est volontaire — une instance en ligne sans code laisserait
# n'importe quel visiteur declencher des appels factures sur ta cle.
#
# Cette valeur est celle a taper dans la case « Code de generation » de
# l'interface. Elle convient en local ; si le projet est mis en ligne,
# la remplacer par autre chose.
CODE_GENERATION=animation

# api / enregistrement / rejeu — voir app/transport.py
#   api            appelle vraiment le modele, et facture ;
#   enregistrement appelle, puis sauvegarde la reponse dans fixtures/ ;
#   rejeu          relit fixtures/, aucun appel, aucun cout.
MODE_MODELE=api
